# Answers `eas credentials:configure-build` prompts so credentials can be set
# up from a script. Apple auth comes from the App Store Connect API key in
# the environment (see README "Apple credentials"); it exits if EAS asks for
# an Apple ID or password instead.
# Usage: expect scripts/eas-credentials.exp <build profile>
set timeout 300
set profile [lindex $argv 0]
log_user 1
spawn env VERA_NOTIFICATION_EXTENSION=1 eas credentials:configure-build -p ios -e $profile
expect {
  -re {\(Y/n\)} { send "y\r"; exp_continue }
  -re {\(y/N\)} { send "y\r"; exp_continue }
  -re {Apple ID:} { send_user "\n!!! ASKED FOR APPLE ID\n"; exit 3 }
  -re {Password} { send_user "\n!!! ASKED FOR PASSWORD\n"; exit 3 }
  -re {Return to submit} { send "\r"; exp_continue }
  -re {Space to select} { send "a\r"; exp_continue }
  timeout { send_user "\n!!! TIMEOUT\n"; exit 2 }
  eof
}
catch wait result
exit [lindex $result 3]
