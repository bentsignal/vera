{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.14.0",
      "pnpm": "10.32.1"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_VERA_DOMAIN": "dev.vera.chat",
        "VERA_NOTIFICATION_EXTENSION": "1"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "internal": {
      "extends": "base",
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_VERA_DOMAIN": "dev.vera.chat",
        "VERA_NOTIFICATION_EXTENSION": "1"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_VERA_DOMAIN": "vera.chat",
        "VERA_NOTIFICATION_EXTENSION": "1"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_VERA_DOMAIN": "vera.chat",
        "VERA_NOTIFICATION_EXTENSION": "1"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "ascAppId": "6818656155",
        "appleTeamId": "39K6A9FP99"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6818656155",
        "appleTeamId": "39K6A9FP99"
      }
    }
  }
}
