{
  "name": "@vera/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore --ignore-path .gitignore",
    "ios": "expo run:ios",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts && tsgo --noEmit"
  },
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.21",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "catalog:",
    "uniwind": "^1.12.1"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@expo/config-plugins": "~57.0.9",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "prettier": "@acme/prettier-config"
}
