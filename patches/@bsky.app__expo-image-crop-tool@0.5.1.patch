+  // Presents once nothing is being dismissed. expo-image-picker hands back
+  // the photo while its picker is still animating away, and UIKit drops a
+  // presentation made during that, which left the promise waiting forever.
+  private func present(_ cropVc: UIViewController, from rootVc: UIViewController, attempts: Int) {
+    let top = rootVc.topmostViewController()
+    guard attempts > 0, let dismissing = top.presentedViewController, dismissing.isBeingDismissed else {
+      Self.darkenMask(of: cropVc, in: top.view.window?.bounds ?? UIScreen.main.bounds)
+      top.present(cropVc, animated: true)
+      return
+    }
+    if let coordinator = dismissing.transitionCoordinator {
+      coordinator.animate(alongsideTransition: nil) { _ in
+        self.present(cropVc, from: rootVc, attempts: attempts - 1)
+      }
+    } else {
+      DispatchQueue.main.asyncAfter(deadline: .now() + 0.05) {
+        self.present(cropVc, from: rootVc, attempts: attempts - 1)
+      }
+    }
+  }
+
+  // Mantis's dark blur around the crop reads as gray over a photo, and its
+  // plain-color masks don't line up with the crop circle. So the blur
+  // stays and gets a black layer inside it, which the blur's mask clips.
+  // The mask views exist after the first layout, so it's laid out here,
+  // before it's presented.
+  private static func darkenMask(of cropVc: UIViewController, in bounds: CGRect) {
+    cropVc.loadViewIfNeeded()
+    cropVc.view.frame = bounds
+    cropVc.view.layoutIfNeeded()
+    func visit(_ view: UIView) {
+      if let effectView = view as? UIVisualEffectView,
+        String(describing: type(of: effectView)) == "CropMaskVisualEffectView" {
+        let tint = UIView(frame: effectView.contentView.bounds)
+        tint.autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        tint.backgroundColor = UIColor.black.withAlphaComponent(0.55)
+        tint.isUserInteractionEnabled = false
+        effectView.contentView.addSubview(tint)
+      }
+      view.subviews.forEach(visit)
     }
+    visit(cropVc.view)
   }
 
