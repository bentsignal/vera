+  // Presents once nothing is being dismissed. expo-image-picker hands back
+  // the photo while its picker is still animating away, and UIKit drops a
+  // presentation made during that, which left the promise waiting forever.
+  private func present(_ cropVc: UIViewController, from rootVc: UIViewController, attempts: Int) {
+    let top = rootVc.topmostViewController()
+    guard attempts > 0, let dismissing = top.presentedViewController, dismissing.isBeingDismissed else {
+      top.present(cropVc, animated: true)
+      return
+    }
+    if let coordinator = dismissing.transitionCoordinator {
+      coordinator.animate(alongsideTransition: nil) { _ in
+        self.present(cropVc, from: rootVc, attempts: attempts - 1)
+      }
+    } else {
+      DispatchQueue.main.asyncAfter(deadline: .now() + 0.05) {
+        self.present(cropVc, from: rootVc, attempts: attempts - 1)
+      }
     }
   }
 
