{
  "name": "@decentralized-convex/messages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./convex.config": "./convex.config.ts"
  },
  "scripts": {
    "build": "tsgo --noEmit",
    "clean": "git clean -xdf .cache .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --ignore-pattern _generated",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@decentralized-convex/core": "workspace:0.1.0",
    "@decentralized-convex/plugin": "workspace:0.1.0",
    "@decentralized-convex/server": "workspace:0.1.0",
    "convex": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@acme/prettier-config"
}
