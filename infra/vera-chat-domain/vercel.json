{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/.well-known/:path*",
      "destination": "https://disciplined-hyena-211.convex.site/.well-known/:path*"
    },
    {
      "source": "/join/:code",
      "destination": "https://disciplined-hyena-211.convex.site/join/:code"
    },
    {
      "source": "/dev/join/:code",
      "destination": "https://disciplined-hyena-211.convex.site/dev/join/:code"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.vera.chat",
      "permanent": false
    }
  ]
}
